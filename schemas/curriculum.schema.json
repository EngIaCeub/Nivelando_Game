{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curriculum",
  "type": "object",
  "required": [
    "examId",
    "disciplines"
  ],
  "properties": {
    "examId": {
      "type": "string"
    },
    "disciplines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "modules"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "weight": {
            "type": [
              "number",
              "null"
            ]
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "topics"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "topics": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "title",
                      "canonicalConceptIds"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "displayTitle": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "description": "Optional concise presentation title; title retains the full curricular scope."
                      },
                      "canonicalConceptIds": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "estimatedMinutes": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "priority": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
