{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question",
  "type": "object",
  "required": [
    "id",
    "examId",
    "stem",
    "options",
    "correctOptionId",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "examId": {
      "type": "string"
    },
    "stem": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "correctOptionId": {
      "type": "string"
    },
    "topicIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonicalConceptIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explanation": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": [
        "status",
        "source"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "derived",
            "assumption"
          ]
        },
        "source": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}