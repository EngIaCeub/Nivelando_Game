{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Didactic library",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "examId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "partial",
        "complete"
      ]
    },
    "scopeReview": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "reviewed"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewedAt",
        "evidence"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "reviewIntervalDays": {
          "type": "integer",
          "minimum": 1
        },
        "freePrimaryRequired": {
          "const": true
        },
        "allowRegistration": {
          "type": "boolean"
        },
        "preferredLanguages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "reviewIntervalDays",
        "freePrimaryRequired",
        "allowRegistration",
        "preferredLanguages"
      ],
      "additionalProperties": false
    },
    "pilotDisciplineIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "topicId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "learningObjectives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "syllabusRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source",
                "locator"
              ],
              "additionalProperties": false
            }
          },
          "prerequisiteUnitIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "topicId",
          "title",
          "learningObjectives",
          "syllabusRefs",
          "prerequisiteUnitIds"
        ],
        "additionalProperties": false
      }
    },
    "studyPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "unitId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "resourceId": { "type": "string", "minLength": 1 },
                "objectiveIndices": {
                  "type": "array",
                  "items": { "type": "integer", "minimum": 0 },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "locator": { "type": "string", "minLength": 1 }
              },
              "required": ["resourceId", "objectiveIndices", "locator"],
              "additionalProperties": false
            }
          },
          "practice": {
            "type": "object",
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "reading": { "type": "string", "minLength": 1 },
              "questions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "stem": { "type": "string", "minLength": 1 },
                    "options": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
                    "correctOptionIndex": { "type": "integer", "minimum": 0 },
                    "explanation": { "type": "string", "minLength": 1 },
                    "sourceResourceId": { "type": "string", "minLength": 1 },
                    "locator": { "type": "string", "minLength": 1 }
                  },
                  "required": ["id", "stem", "options", "correctOptionIndex", "explanation", "sourceResourceId", "locator"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["title", "reading", "questions"],
            "additionalProperties": false
          },
          "editorialReview": {
            "type": "object",
            "properties": {
              "status": { "enum": ["pending", "approved", "rejected"] },
              "reviewer": { "type": ["string", "null"] },
              "reviewedAt": {
                "anyOf": [
                  { "type": "string", "format": "date-time" },
                  { "type": "null" }
                ]
              },
              "evidence": { "type": "string" }
            },
            "required": ["status", "reviewer", "reviewedAt", "evidence"],
            "additionalProperties": false
          }
        },
        "required": ["id", "unitId", "title", "steps", "editorialReview"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "examId",
    "status",
    "scopeReview",
    "policy",
    "pilotDisciplineIds",
    "units"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "scopeReview": {
            "properties": {
              "status": {
                "const": "reviewed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "scopeReview": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewedAt": {
                "type": "string",
                "format": "date-time"
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "units": {
            "items": {
              "properties": {
                "syllabusRefs": {
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
